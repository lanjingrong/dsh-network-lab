{
  "name": "dsh-network-lab",
  "version": "0.8.0",
  "description": "DeepSeek Harness 网络工程实验插件：eNSP Telnet、HCIA 路线、10 个实验、12 个故障、20 条踩坑知识库、练完就测、安全重启验证",
  "type": "module",
  "private": false,
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/**/*.js",
    "prompts/**/*.md",
    "skills/**/*.md",
    "cordis.patch.yml",
    "install.ps1",
    "README.md",
    "PROMPTS.md",
    "使用说明.md",
    "HCIA学习路线.md",
    "带教笔记.md"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node test/run-all.mjs",
    "check": "node --check index.js && node --check lib/telnet.js && node --check lib/store.js && node --check lib/labs.js"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "ensp",
    "huawei",
    "vrp",
    "hcia",
    "networking",
    "telnet",
    "lab"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lanjingrong/dsh-network-lab.git"
  },
  "bugs": {
    "url": "https://github.com/lanjingrong/dsh-network-lab/issues"
  },
  "homepage": "https://github.com/lanjingrong/dsh-network-lab#readme"
}
